# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never contain real values.

# --- Bedrock (already working) ----------------------------------------------
AWS_REGION=us-east-1
NOVA_EMBED_MODEL_ID=amazon.nova-2-multimodal-embeddings-v1:0
NOVA_LITE_MODEL_ID=global.amazon.nova-2-lite-v1:0

# --- Supabase ---------------------------------------------------------------
# Project Settings -> Database -> Connection string -> URI.
# Use the DIRECT connection (port 5432), not the transaction pooler (6543):
# asyncpg uses prepared statements, which pgbouncer in transaction mode rejects.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Slack ------------------------------------------------------------------
# Just the subdomain: for https://acme.slack.com this is "acme".
# Leave blank and citations ship without links rather than with guessed ones.
SLACK_WORKSPACE_DOMAIN=

# --- App --------------------------------------------------------------------
# Change before deploying. The current default is hardcoded in the frontend too.
API_KEY=recall-demo-key

# Gate for the public demo (spec 1.5). Any non-empty value turns it on.
ACCESS_CODE=
