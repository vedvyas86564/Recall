# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never contain real values.

# --- Bedrock (already working) ----------------------------------------------
AWS_REGION=us-east-1
NOVA_EMBED_MODEL_ID=amazon.nova-2-multimodal-embeddings-v1:0
NOVA_LITE_MODEL_ID=global.amazon.nova-2-lite-v1:0

# --- Supabase ---------------------------------------------------------------
# Project Settings -> Database -> Connection string. Three options are offered;
# only two work here.
#
#   Direct         db.<ref>.supabase.co:5432              works, but IPv6-only
#                                                          on new projects
#   Session pooler <region>.pooler.supabase.com:5432      works, IPv4 -- use
#                                                          this if direct fails
#   Transaction    <region>.pooler.supabase.com:6543      DOES NOT WORK
#
# Transaction mode breaks asyncpg, which relies on prepared statements that
# pgbouncer rejects in that mode. It surfaces as DuplicatePreparedStatementError,
# which reads like a code bug rather than a config one. Session mode is fine.
#
# Remember to substitute your real password for [YOUR-PASSWORD] in the string.
DATABASE_URL=

# --- Slack ------------------------------------------------------------------
# Just the subdomain: for https://acme.slack.com this is "acme".
# Leave blank and citations ship without links rather than with guessed ones.
SLACK_WORKSPACE_DOMAIN=

# --- App --------------------------------------------------------------------
# Change before deploying. The current default is hardcoded in the frontend too.
API_KEY=recall-demo-key

# Gate for the public demo (spec 1.5). Any non-empty value turns it on.
ACCESS_CODE=
